      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(wecert_certificate_consecutive_failures >= 5) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
