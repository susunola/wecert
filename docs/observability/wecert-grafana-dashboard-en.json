              {
                "color": "yellow",
                "value": 0
              },
              {
                "color": "green",
                "value": 11.25
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Days left"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Certificate"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
