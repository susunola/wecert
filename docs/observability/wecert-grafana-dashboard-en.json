    {
      "type": "table",
      "title": "Certificate Expiry Detail (days left, ascending)",
      "description": "Thresholds mirror the alerts: classic <22.5d / tlsserver <11.25d / shortlived <40h (~=1.67d). Negative = already expired. Columns: certificate, profile, days left.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 9,
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sortBy": [
              {
                "desc": false,
                "field": "Value"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "cert": 0,
              "profile": 1,
              "Value": 2
            },
            "renameByName": {
              "Value": "Days left",
              "cert": "Certificate",
              "profile": "Profile"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
