bin/
dist/
coverage.out
*.db
*.db-wal
*.db-shm

# terraform
.terraform/
*.tfstate
*.tfstate.*
tfplan
terraform.tfvars

# Local config files. These are copies of the examples filled in with real values,
# which means dns.loginToken (full record write over every zone in the account) and
# tencent.secretId/secretKey. Only the committed examples -- config.example.yaml
# and the e2e-config-*.yaml fixtures -- belong in the repository.
#
# Anchored to the repository root so the fixtures above can never be caught by
# accident, whatever they are renamed to later.
/config.yaml
/e2e-config.yaml
*.local.yaml

# Local sandbox redirect for the Go caches (holds absolute paths, must not be committed)
.goenv

# Python bytecode
__pycache__/
*.pyc

# Go build outputs. `go build ./cmd/x/` in the repository root drops the binary here (the
# path, not just the name, is what those two entries above miss), and a 12 MB arm64 binary
# was once committed by exactly that accident.
/wecert
/wecert-probe
/wecert-onboard
/clbverify
/tatrun
/preflight
