# Copy to terraform.tfvars and adjust.
# Credentials do not belong here — use the environment variables
# TENCENTCLOUD_SECRET_ID / TENCENTCLOUD_SECRET_KEY.

region            = "ap-guangzhou"
availability_zone = "ap-guangzhou-3"
name_prefix       = "wecert-test"

# Stage B: VPC + CLB + HTTPS listener + a placeholder certificate
create_clb         = true
clb_network_type   = "INTERNAL" # internal-facing, which avoids EIP charges
clb_sni_domain     = "placeholder.wecert-test.invalid"

# Stage C: add a CVM (off by default; this is the expensive part)
create_cvm        = false
enable_cvm_role   = false
cam_role_name     = "wecert-test-role"
cvm_instance_type = "S5.MEDIUM2"
cvm_image_id      = "img-487zeit5" # Ubuntu 22.04 LTS (ap-guangzhou)
