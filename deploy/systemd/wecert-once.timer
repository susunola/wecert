[Unit]
Description=定时触发 wecert 单轮收敛

[Timer]
# 显式指向 once 服务。
#
# 不写这一行时，systemd 会把 wecert-once.timer 解析成同名的
# wecert-once.service —— 这正是我们要的，但依赖"文件名恰好等于
# 目标服务名"这种隐式约定太脆：一旦有人把 timer 改成 wecert.timer，
# 它就会静默指向常驻的 wecert.service，定时模式从此再也不生效。
Unit=wecert-once.service

# 每小时跑一次。续期是否真的发生由 ARI 窗口决定，
# 跑得勤只是让"窗口一到就动"，不会因此多下单。
OnBootSec=2min
OnUnitActiveSec=1h
# 加抖动，避免多实例同时敲 CA 的门。
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
