[Unit]
Description=Triggers one wecert convergence pass on a schedule

[Timer]
# Point explicitly at the once service.
#
# Without this line systemd resolves wecert-once.timer to a same-named
# wecert-once.service — which is what we want, but relying on "the filename
# happens to equal the target service name" is too fragile: rename the timer
# to wecert.timer and it silently points at the long-running wecert.service,
# after which scheduled mode never runs again.
Unit=wecert-once.service

# Once an hour. Whether a renewal actually happens is decided by the ARI
# window, so running often only means "act as soon as the window opens" —
# it does not place extra orders.
OnBootSec=2min
OnUnitActiveSec=1h
# Jitter, so several instances do not knock on the CA's door at the same moment.
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
