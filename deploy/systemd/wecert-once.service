# Alternative to the daemon: drive wecert from a systemd timer instead.
# Useful when you would rather not run a long-lived process, or prefer
# "start, do one pass, exit".
#
# To switch:
#   systemctl disable --now wecert.service
#   systemctl enable --now wecert-once.timer

[Unit]
Description=wecert single-pass convergence (driven by wecert-once.timer)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
User=wecert
Group=wecert

StateDirectory=wecert
StateDirectoryMode=0700

ExecStart=/usr/local/bin/wecert -config /etc/wecert/config.yaml -once

# Worst case for one pass is roughly, per certificate: 5m of DNS propagation
# + 3m waiting for authorizations + 2m waiting for the order. reconcile walks
# the certificates **serially**, so leave headroom proportional to how many
# you have. Being killed is not fatal by itself — the order URL is already on
# disk and the next pass resumes it — and it does not count as a failure either:
# recordFailure returns early for context.Canceled and context.DeadlineExceeded,
# so a kill on timeout leaves consecutive_failures untouched and the next pass
# starts from the same place. (This comment used to claim the opposite — that
# every interruption bumped consecutive_failures — which was true before that
# guard and is exactly the kind of stale claim that makes an operator distrust a
# real alarm.) Raise this when you have many certificates, or certificates with
# many SANs.
TimeoutStartSec=45min

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/wecert

# ── Hardening beyond the baseline ────────────────────────────────────────────
#
# Same posture as wecert.service: the oneshot form runs the same binary with the
# same credentials and the same private-key database. A weaker timer unit would
# make "start, do one pass, exit" the easier deployment choice AND the less
# protected one -- the opposite of what a hardening section is for.
#
# `systemd-analyze security wecert-once.service` is the way to check the effect.

# No capabilities at all: wecert binds no privileged port, does no raw I/O, and
# never changes uid. An empty bounding set cannot be re-acquired.
CapabilityBoundingSet=
AmbientCapabilities=

# Only the address families it actually uses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The standard service sandbox: no new namespaces, no setuid/setgid transitions, no
# personality changes, and no /proc visibility into other processes.
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid

# Kernel surfaces a certificate renewer has no business touching.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Go never needs writable+executable memory, and wecert never forks a child.
MemoryDenyWriteExecute=true
RestrictRealtime=true
RemoveIPC=true
SystemCallArchitectures=native

# Umask for anything the process creates itself; StateDirectoryMode covers the
# directory, this covers files the database driver makes inside it.
UMask=0077

# No core dumps: a crash would write the ACME account key and every certificate
# private key into a world-readable crash file. (MemoryDenyWriteExecute does not
# stop the kernel from dumping.)
LimitCORE=0
