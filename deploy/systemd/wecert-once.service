# 备选方案：用 systemd timer 代替常驻守护进程。
# 适合不想跑长驻进程、或者偏好"每次执行完就退出"的场景。
#
# 启用方式：
#   systemctl disable --now wecert.service
#   systemctl enable --now wecert-once.timer

[Unit]
Description=wecert 单轮收敛（配合 wecert-once.timer）
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
User=wecert
Group=wecert

StateDirectory=wecert
StateDirectoryMode=0700

ExecStart=/usr/local/bin/wecert -config /etc/wecert/config.yaml -once

# 单轮的最坏耗时 ≈ 每张证书 (DNS 传播 5m + 授权等待 3m + 订单等待 2m)，
# 而 reconcile 是**串行**遍历所有证书的，所以这个值要按证书数量留足余量。
# 被打断本身不致命（订单已落盘，下一轮接着推进），
# 但每次都会推高 consecutive_failures，制造无谓的告警。
# 证书多或 SAN 多时请相应上调。
TimeoutStartSec=45min

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/wecert
