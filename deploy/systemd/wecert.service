[Unit]
Description=wecert — automatic ACME certificate renewal (Tencent Cloud CLB)
Documentation=https://github.com/susunola/wecert
After=network-online.target time-sync.target systemd-time-wait-sync.service
Wants=network-online.target

[Service]
Type=simple
User=wecert
Group=wecert

# Creates /var/lib/wecert with the right owner. state.db has to survive:
# losing it means re-issuing orders, which runs into the rate limits.
StateDirectory=wecert
StateDirectoryMode=0700

ExecStart=/usr/local/bin/wecert -config /etc/wecert/config.yaml
Restart=on-failure
RestartSec=30s

# The whole filesystem is read-only except the write paths granted below.
# /etc/wecert has to be among them: every management write -- adding a
# certificate, saving a notification channel, deleting one -- rewrites
# config.yaml atomically, which means creating a temp file in /etc/wecert and
# renaming it. With the directory read-only the console reports
# "write /etc/wecert/config.yaml: open /etc/wecert/.atomic-N.tmp: read-only
# file system" for each of those buttons while the read-only pages keep
# working, which reads like a broken button and is actually a sandbox one.
# (This used to be ReadOnlyPaths=/etc/wecert, which made the refusal certain.)
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/etc/wecert
# A local-nginx deploy target (deploy.target: nginx) writes the certificate and
# key under nginx.dirTemplate -- /etc/nginx/ssl/%s by default -- which
# ProtectSystem=strict also blocks. Uncomment when that target is in use; with
# the cloud (CLB) target the daemon never touches /etc/nginx.
#ReadWritePaths=/etc/nginx

# ── Hardening beyond the baseline ────────────────────────────────────────────
#
# The daemon needs nothing but outbound TCP/DNS and write access to its own
# StateDirectory. Everything below closes post-exploitation reach that the
# baseline above leaves open; none of it changes what the process can do when it
# behaves.
#
# `systemd-analyze security wecert.service` is the way to check the effect.

# No capabilities at all: wecert binds no privileged port, does no raw I/O, and
# never changes uid. An empty bounding set cannot be re-acquired.
CapabilityBoundingSet=
AmbientCapabilities=

# Only the address families it actually uses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The standard service sandbox: no new namespaces, no setuid/setgid transitions, no
# personality changes, and no /proc visibility into other processes.
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid

# Kernel surfaces a certificate renewer has no business touching.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Go never needs writable+executable memory, and wecert never forks a child.
MemoryDenyWriteExecute=true
RestrictRealtime=true
RemoveIPC=true
SystemCallArchitectures=native

# Umask for anything the process creates itself; StateDirectoryMode covers the
# directory, this covers files the database driver makes inside it.
UMask=0077

# No core dumps: a crash would write the ACME account key and every certificate
# private key into a world-readable crash file. (MemoryDenyWriteExecute does not
# stop the kernel from dumping.)
LimitCORE=0

[Install]
WantedBy=multi-user.target
