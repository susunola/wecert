[Unit]
Description=wecert — automatic ACME certificate renewal (Tencent Cloud CLB)
Documentation=https://github.com/susunola/wecert
After=network-online.target time-sync.target systemd-time-wait-sync.service
Wants=network-online.target

[Service]
Type=simple
User=wecert
Group=wecert

# Creates /var/lib/wecert with the right owner. state.db has to survive:
# losing it means re-issuing orders, which runs into the rate limits.
StateDirectory=wecert
StateDirectoryMode=0700

ExecStart=/usr/local/bin/wecert -config /etc/wecert/config.yaml
Restart=on-failure
RestartSec=30s

# The config file holds the DNSPod token, so ProtectSystem=strict bounds what
# this process can write.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/wecert

[Install]
WantedBy=multi-user.target
